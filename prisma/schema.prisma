// Vertex — Prediction Market Terminal
// Schema for cross-exchange prediction market data

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime queries go through Neon's pooled endpoint (`-pooler`), which is
  // required for serverless Prisma queries at scale.
  url      = env("DATABASE_URL")
  // Migrations need a *direct* (non-pooled) connection — Prisma uses Postgres
  // advisory locks to serialize migrations and PgBouncer breaks session-scoped
  // locks, so `prisma migrate deploy` hangs against the pooled URL.
  directUrl = env("DIRECT_URL")
}

// ============ Exchanges ============

enum ExchangeName {
  POLYMARKET
  KALSHI
}

model Exchange {
  id          String       @id @default(cuid())
  name        ExchangeName @unique
  displayName String
  websiteUrl  String
  createdAt   DateTime     @default(now())

  listings ExchangeListing[]
}

// ============ Markets ============

enum MarketStatus {
  OPEN
  CLOSED
  RESOLVED
  CANCELED
}

// Canonical market — represents a single real-world question that may
// be listed on multiple exchanges. Cross-exchange normalization happens here.
model Market {
  id          String       @id @default(cuid())
  slug        String       @unique
  question    String
  description String?
  category    String?
  status      MarketStatus @default(OPEN)
  resolvesAt  DateTime?
  resolvedAt  DateTime?
  resolution  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  listings       ExchangeListing[]
  watchlistItems WatchlistItem[]
  alerts         Alert[]

  @@index([status])
  @@index([category])
}

model ExchangeListing {
  id          String   @id @default(cuid())
  marketId    String
  exchangeId  String
  externalId  String
  externalUrl String?
  yesTokenId  String?
  noTokenId   String?
  rawPayload  Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  market   Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  exchange Exchange @relation(fields: [exchangeId], references: [id])
  quotes   Quote[]

  @@unique([exchangeId, externalId])
  @@index([marketId])
}

model Quote {
  id                String   @id @default(cuid())
  exchangeListingId String
  bid               Float?
  ask               Float?
  last              Float?
  volume24h         Float?
  liquidity         Float?
  timestamp         DateTime @default(now())

  exchangeListing ExchangeListing @relation(fields: [exchangeListingId], references: [id], onDelete: Cascade)

  @@index([exchangeListingId, timestamp])
}

/// API key for Institutional-tier programmatic access. The full key is
/// only shown once at generation time (returned by the create endpoint).
/// We store a hash so we can verify incoming Bearer tokens without ever
/// knowing the plaintext after issuance.
model ApiKey {
  id         String    @id @default(cuid())
  userEmail  String
  name       String
  /// SHA-256 hash of the full secret key. Unique so lookups are O(1).
  keyHash    String    @unique
  /// First 8 chars of the plaintext (e.g. "fk_abc12…") so we can display a
  /// hint in the account UI without revealing the full key.
  keyPrefix  String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userEmail])
  @@index([keyHash])
}

/// Per-user, per-feature, per-day count. Increments on each successful
/// feature use so we can enforce daily caps (currently: AI Overview 20/day
/// for Pro; Institutional is unlimited).
model UsageLog {
  id        BigInt   @id @default(autoincrement())
  userEmail String
  feature   String
  /// Date-only bucket key, UTC (e.g. "2026-06-30"). String rather than Date
  /// because Postgres date columns get awkward with Prisma timezones.
  day       String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userEmail, feature, day])
  @@index([userEmail, day])
}

/// User subscription state, mirrored from Stripe via webhooks. Keyed on
/// the Supabase user email so we can look up tier without needing a join
/// against Supabase's user table. `tier` and `status` gate feature access
/// across the app.
model Subscription {
  id                   String    @id @default(cuid())
  userEmail            String    @unique
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  /// "free" | "pro" | "institutional"
  tier                 String    @default("free")
  /// "active" | "trialing" | "canceled" | "past_due" | "incomplete"
  status               String    @default("active")
  /// "monthly" | "yearly" — null on free
  interval             String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userEmail])
  @@index([stripeCustomerId])
}

/// Historical YES-probability observation captured by the heatmap backfill
/// cron. One row per (tokenId, hour-bucket). Used to compute the global
/// N×N correlation matrix without hitting Polymarket for every query.
model PriceObservation {
  id         BigInt   @id @default(autoincrement())
  tokenId    String
  question   String
  category   String
  /// Bucket start time — always aligned to the top of the hour.
  observedAt DateTime
  price      Float
  volume24h  Float?
  createdAt  DateTime @default(now())

  @@unique([tokenId, observedAt])
  @@index([tokenId])
  @@index([observedAt])
  @@index([category, observedAt])
}

// ============ Users / Watchlists / Alerts ============

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String?
  createdAt   DateTime @default(now())

  watchlists Watchlist[]
  alerts     Alert[]
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WatchlistItem[]

  @@index([userId])
}

model WatchlistItem {
  id          String   @id @default(cuid())
  watchlistId String
  marketId    String
  addedAt     DateTime @default(now())

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  market    Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, marketId])
}

enum AlertRuleType {
  PRICE_ABOVE
  PRICE_BELOW
  SPREAD_WIDENS
  VOLUME_SPIKE
}

enum AlertChannel {
  EMAIL
  WEBHOOK
  IN_APP
}

model Alert {
  id               String        @id @default(cuid())
  userId           String
  /// Optional FK to a hydrated Market record. We store external info
  /// directly so alerts work for any Polymarket market without first
  /// syncing the Market table.
  marketId         String?
  exchange         ExchangeName
  externalMarketId String
  marketQuestion   String
  ruleType         AlertRuleType
  threshold        Float
  channel          AlertChannel
  destination      String
  isActive         Boolean       @default(true)
  lastFiredAt      DateTime?
  createdAt        DateTime      @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  market Market? @relation(fields: [marketId], references: [id], onDelete: SetNull)

  notifications Notification[]

  @@index([userId])
  @@index([marketId])
  @@index([exchange, externalMarketId])
  @@index([isActive])
}

/// A fired alert instance surfaced in the in-app notification bell.
/// Written by the alerts/check cron when an alert with channel IN_APP
/// triggers. Persisted so the user can see the history and mark items read.
model Notification {
  id             BigInt    @id @default(autoincrement())
  alertId        String
  userEmail      String
  title          String
  body           String
  marketQuestion String
  externalUrl    String?
  triggeredAt    DateTime  @default(now())
  readAt         DateTime?

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([userEmail, readAt])
  @@index([alertId])
  @@index([triggeredAt])
}
